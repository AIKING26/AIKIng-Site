# Copy this file to .env.local for local development:
#   cp .env.example .env.local
# .env.local is gitignored. Never commit it.
#
# For production: set these same values in
#   Vercel → Project Settings → Environment Variables
# After adding env vars in Vercel, trigger a redeploy for them to take effect.

# ===== ConvertKit (email list) =====
# Where to find these in ConvertKit:
#   API Key:  Account → Settings → Advanced → API Key (v3, public-safe)
#   Form ID:  Grow → Landing Pages & Forms → click your form
#             → the number in the URL (kit.com/forms/XXXXXXX/edit)
VITE_CONVERTKIT_API_KEY=
VITE_CONVERTKIT_FORM_ID=
